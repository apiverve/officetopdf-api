{
    "name": "apiverve/officetopdf",
    "description": "Office to PDF converts Word, Excel, PowerPoint, OpenDocument, RTF, text and CSV files to PDF and returns a download link valid for 2 days, with the page count of the result. Upload the file or send its URL. Paid plans can convert only selected pages and set landscape orientation.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "officetopdf",
        "office to pdf api",
        "docx to pdf api",
        "word to pdf api",
        "excel to pdf api",
        "xlsx to pdf api"
    ],
    "homepage": "https://apiverve.com/marketplace/officetopdf?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/officetopdf",
        "source": "https://github.com/apiverve/officetopdf-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Officetopdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Officetopdf\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
